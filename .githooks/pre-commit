#!/usr/bin/env bash
# Keeps public/skills/ in sync automatically instead of letting it drift and
# then blocking the push later. This runs scripts/sync-skill-assets.sh
# unconditionally and stages whatever it produces — cheap, since git add is
# a no-op when nothing changed — so a commit never has to be redone by hand
# just to pick up a skill-repo change someone forgot about.
#
# Why here and not only in pre-push: pre-commit runs BEFORE the commit is
# made, so anything it regenerates can still be folded into the very commit
# that's about to land — unlike pre-push, which runs after, when the fix
# would land unpushed and uncommitted. pre-push is kept as-is as a safety
# net for a commit made with --no-verify, or from a checkout where this
# hook didn't run for some other reason.
#
# Never blocks: a sync failure (offline, GitHub unreachable, missing
# `unzip`/`zip`) is a warning, not a rejected commit — the same "allow on
# doubt" posture pre-push already takes.
#
# Escape hatch: SKIP_SKILL_SYNC=1 git commit ...

set -euo pipefail

if [[ -n "${SKIP_SKILL_SYNC:-}" ]]; then
  echo "pre-commit: SKIP_SKILL_SYNC set — skipping skill-asset sync."
  exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
PUBLIC_SKILLS="${REPO_ROOT}/public/skills"
SYNC_SCRIPT="${REPO_ROOT}/scripts/sync-skill-assets.sh"

# Nothing to sync in a checkout that doesn't carry these artifacts, or that
# doesn't have the sync script itself.
[[ -f "${PUBLIC_SKILLS}/embarko-deploy.sh" && -f "${SYNC_SCRIPT}" ]] || exit 0

if ! command -v curl >/dev/null 2>&1 || ! command -v unzip >/dev/null 2>&1 || ! command -v zip >/dev/null 2>&1; then
  echo "pre-commit: curl/zip/unzip not all available — skipping skill-asset sync." >&2
  exit 0
fi

if ! bash "${SYNC_SCRIPT}" >/tmp/pre-commit-sync-skill.log 2>&1; then
  echo "pre-commit: 'npm run sync:skill' failed — committing without updating public/skills/." >&2
  echo "            See /tmp/pre-commit-sync-skill.log, or run it yourself when convenient." >&2
  exit 0
fi

# Stage regardless of whether THIS run changed anything on disk — what
# matters is whether public/skills/ now differs from what's already
# committed (HEAD), which is what would otherwise block the push later,
# not whether re-running the sync script itself produced new bytes.
if git diff --quiet -- "${PUBLIC_SKILLS}" && git diff --cached --quiet -- "${PUBLIC_SKILLS}"; then
  echo "pre-commit: public/skills/ already in sync with the published skill repo."
else
  git add "${PUBLIC_SKILLS}"
  echo "pre-commit: public/skills/ was stale relative to the published skill repo —"
  echo "            regenerated it and added it to this commit."
fi

exit 0
