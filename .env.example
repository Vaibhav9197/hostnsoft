# hostnsoft console — environment

# --- hostnsoft-api (control plane) ---------------------------------------
# Base URL the Next.js BFF proxy forwards to. The browser never calls this
# directly; all requests go through /api/hns/* and /api/auth/* on this app.
# The backend mounts its routes under /api, so the base MUST include /api.
HOSTNSOFT_API_URL=https://ship.hostnsoft.com/api

# --- MSG91 proxy-auth login widget --------------------------------------
# referenceId is a frontend-only value issued by the MSG91 proxy-auth
# dashboard (proxy.msg91.com). A default is baked in for the existing
# account; override here to point at a different MSG91 configuration.
NEXT_PUBLIC_MSG91_REFERENCE_ID=117230j17876397376a8d37b972ce7
# Widget script URL (rarely needs changing).
NEXT_PUBLIC_MSG91_WIDGET_SCRIPT=https://proxy.msg91.com/assets/proxy-auth/proxy-auth.js

# --- Marketing site early-access form ------------------------------------
# EARLY_ACCESS_WEBHOOK_URL=https://flow.sokt.io/func/scripHKzReOX
