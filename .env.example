# hostnsoft console — environment

# --- hostnsoft-api (control plane) ---------------------------------------
# Base URL the Next.js BFF proxy forwards to. The browser never calls this
# directly; all requests go through /api/hns/* and /api/auth/* on this app.
# The backend mounts its routes under /api, so the base MUST include /api.
HOSTNSOFT_API_URL=https://ship.embarko.ai/api

# --- MSG91 proxy-auth login widget --------------------------------------
# referenceId is a frontend-only value issued by the MSG91 proxy-auth
# dashboard (proxy.msg91.com). A default is baked in for the existing
# account; override here to point at a different MSG91 configuration.
NEXT_PUBLIC_MSG91_REFERENCE_ID=117230j17876397376a8d37b972ce7
# Widget script URL (rarely needs changing).
NEXT_PUBLIC_MSG91_WIDGET_SCRIPT=https://proxy.msg91.com/assets/proxy-auth/proxy-auth.js

# --- Marketing site early-access form ------------------------------------
# EARLY_ACCESS_WEBHOOK_URL=https://flow.sokt.io/func/scripHKzReOX

# --- Monitoring (docs/MONITORING.md) ------------------------------------
# Both are secrets: set them in the Cloudflare dashboard, never in a file
# that's committed. MONITOR_SECRET is what the viaSocket scheduler sends as
# X-Monitor-Secret; MONITOR_PROXY_TOKEN is a super-admin's sign-in token, so
# the monitor can read the admin app list and customer queries.
# MONITOR_SECRET=
# MONITOR_PROXY_TOKEN=

# --- Google Tag Manager -------------------------------------------------
# The live container (GTM-TGB5Z6TK) is pinned in app/lib/gtm.ts, because
# NEXT_PUBLIC_* is inlined at build time and every .env file here is
# gitignored — an env-only value would vanish on any build that isn't yours.
# Production picks it up automatically; dev and preview stay off.
#
# Set this ONLY to override: a test container to debug locally, or an empty
# string to disable GTM in production without a code change.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
