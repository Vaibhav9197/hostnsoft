{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hostnsoft",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // EARLY_ACCESS_WEBHOOK_URL is set manually in the Cloudflare dashboard,
  // so it's intentionally NOT defined here. keep_vars preserves dashboard
  // vars/secrets across deploys instead of wiping them.
  "keep_vars": true,
  // Custom domains, not route patterns. The embarko.ai zone has no DNS records
  // at all, and a bare route pattern does not create one -- it would attach and
  // then serve nothing. custom_domain lets Wrangler create the DNS record and
  // bind the hostname in one step. Patterns are bare hostnames here: custom
  // domains cover the whole host, so no "/*" and no zone_name.
  "routes": [
    {
      "pattern": "embarko.ai",
      "custom_domain": true
    },
    {
      "pattern": "www.embarko.ai",
      "custom_domain": true
    }
  ]
}
