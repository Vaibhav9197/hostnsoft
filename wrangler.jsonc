{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hostnsoft",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // A/B metrics store. This used to be a better-sqlite3 file under DATA_DIR,
  // which works on a Node host but not here -- workerd cannot load a native
  // addon, so every write threw and production recorded nothing. D1 is SQLite
  // too, so the schema and queries carried over unchanged.
  //
  // Two bindings, one database. Deployed they are the same thing; the split
  // only matters in `next dev`:
  //
  //   DB        stays local, so browsing the site on localhost cannot inject
  //             page views and clicks into the real A/B results -- /api/events
  //             writes on every single page view, so a remote write binding
  //             would corrupt the very numbers this exists to measure.
  //   DB_ADMIN  `remote: true`, so the admin dashboard reads the production
  //             figures instead of whatever this machine happens to have.
  //
  // Consequence worth knowing while developing: a CTA you click on localhost
  // lands in the local database, so the dashboard will not move.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hostnsoft-ab",
      "database_id": "115e79d8-c987-4dcb-9172-5aded5c264c6"
    },
    {
      "binding": "DB_ADMIN",
      "database_name": "hostnsoft-ab",
      "database_id": "115e79d8-c987-4dcb-9172-5aded5c264c6",
      "remote": true
    }
  ],
  // EARLY_ACCESS_WEBHOOK_URL is set manually in the Cloudflare dashboard,
  // so it's intentionally NOT defined here. keep_vars preserves dashboard
  // vars/secrets across deploys instead of wiping them.
  "keep_vars": true,
  // Control-plane base the BFF proxy forwards to. Pinned here rather than left
  // to the dashboard so the API host is version-controlled and reviewable. The
  // backend mounts its routes under /api, so the base MUST include /api.
  "vars": {
    "HOSTNSOFT_API_URL": "https://ship.embarko.ai/api"
  },
  // Custom domains, not route patterns. The embarko.ai zone has no DNS records
  // at all, and a bare route pattern does not create one -- it would attach and
  // then serve nothing. custom_domain lets Wrangler create the DNS record and
  // bind the hostname in one step. Patterns are bare hostnames here: custom
  // domains cover the whole host, so no "/*" and no zone_name.
  "routes": [
    {
      "pattern": "embarko.ai",
      "custom_domain": true
    },
    {
      "pattern": "www.embarko.ai",
      "custom_domain": true
    }
  ]
}
